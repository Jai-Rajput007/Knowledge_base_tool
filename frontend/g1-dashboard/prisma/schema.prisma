// Prisma schema
// Run migrations: npx prisma migrate dev
// Seed: npx prisma db seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SQLite note: no enums, no String[], no @db.Text — use String throughout

model Tenant {
  id                 String   @id @default(uuid())
  name               String
  host               String?  // Person assigned / Admin name
  companyDescription String?  // Description of company
  companyLogo        String?  // URL or base64 of logo
  companyType        String?  // Type of company
  features           String   @default("{}") // JSON stored as text
  users              User[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  mcpConfigs TenantMcpConfig[]
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String
  role     String @default("VIEWER") // SUPER_ADMIN | CLIENT | VIEWER
  requiresPasswordChange Boolean @default(true)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personas        Persona[]
  personaVersions PersonaVersion[]
}

model Persona {
  id String @id @default(uuid())

  name       String
  version    Int     @default(1)
  isActive   Boolean @default(true)
  isTemplate Boolean @default(false)

  robotName     String @default("Jarvis")
  robotCompany  String @default("Jindal Steel")
  robotLocation String @default("Delhi")
  robotRole     String @default("Office assistant robot")
  robotVoice    String @default("Male")

  systemPrompt      String @default("")
  conversationRules String @default("[]") // JSON array as text

  wakeWord String @default("hey_jarvis")
  llmMode  String @default("local")
  asrMode  String @default("parakeet")
  ttsMode  String @default("g1_direct")

  syncStatus   String    @default("not_synced")
  lastSyncedAt DateTime?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  versions PersonaVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PersonaVersion {
  id String @id @default(uuid())

  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  version       Int
  snapshot      String  // JSON stored as text
  changeSummary String?

  syncedToRobot Boolean   @default(false)
  syncedAt      DateTime?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}

model PersonaTemplate {
  id          String  @id @default(uuid())
  name        String
  description String?
  category    String?
  tags        String  @default("[]") // JSON array as text

  isSystem     Boolean @default(false)
  templateData String  @default("{}") // JSON stored as text

  useCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model McpIntegration {
  id              String   @id @default(uuid())
  name            String
  category        String
  description     String
  iconUrl         String?
  tier            String   @default("BASIC") // "BASIC" or "PRO"
  
  provider        String   
  providerConfig  String   @default("{}") // JSON text
  requiredFields  String   @default("[]") // JSON text
  
  tenantConfigs   TenantMcpConfig[]
}

model TenantMcpConfig {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  mcpId           String
  mcp             McpIntegration @relation(fields: [mcpId], references: [id], onDelete: Cascade)
  
  isUnlocked      Boolean  @default(false) 
  isEnabled       Boolean  @default(false)
  credentials     String   @default("{}") // JSON text
  
  @@unique([tenantId, mcpId])
}
